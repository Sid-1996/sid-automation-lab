---
import { u } from '../lib/url';
// src/components/RedirectPage.astro
// 既有公開 URL → 新架構頁面的轉址頁（實作 Q4 / Q17 的 URL 策略）
//
// GitHub Pages 無伺服器端 301，標準做法為：
//   1. <meta http-equiv="refresh" content="0; url=目標">   —— 瀏覽器立即導向
//   2. <link rel="canonical" href="目標">                  —— 權重集中到目標頁
//   3. <meta name="robots" content="noindex,follow">      —— 避免轉址頁被索引
//   4. JS location.replace()                                —— 不在瀏覽器歷史留下紀錄
// 目標相對路徑一律以 / 開頭，錨點以 # 表示。
interface Props {
  /** 轉址目標（站內路徑，含查詢字串與錨點） */
  to: string;
  /** 轉址頁自身的路徑（用於 canonical 與說明文字） */
  from: string;
  /** 頁面 <title> */
  title: string;
  /** 轉址失敗時顯示的說明 */
  note?: string;
  /** 是否保留來源頁的查詢字串（例：/search.html?q=xxx → /projects.html?q=xxx） */
  preserveQuery?: boolean;
}
const { to, from, title, note = '這個頁面已搬家，正在前往新位置…', preserveQuery = false } = Astro.props;
const SITE = 'https://sid-1996.github.io/sid-automation-lab';
// 實際導向路徑（含 base 前綴）；站外絕對網址原樣保留
const dest = u(to);
// canonical 不帶錨點（fragment 對 canonical 無意義，搜尋引擎會忽略）
// 站外轉址則 canonical 指向站外目標本身
const isExternal = /^https?:\/\//i.test(to);
const canonical = isExternal ? to : `${SITE}${to.split('#')[0]}`;
---

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="robots" content="noindex,follow" />
  <meta http-equiv="refresh" content={`0; url=${dest}`} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
  <style>
    body {
      margin: 0; min-height: 100vh; display: grid; place-items: center;
      background: #0b0e12; color: #9aa8b4;
      font-family: "PingFang TC", "Microsoft JhengHei", system-ui, sans-serif;
    }
    .box {
      border: 1px solid #232c37; border-radius: 3px; background: #141a21;
      padding: 32px; max-width: 420px; text-align: center;
    }
    .mark {
      width: 12px; height: 12px; border: 1px solid #4ae3b0; position: relative;
      margin: 0 auto 20px;
    }
    .mark::after { content: ""; position: absolute; inset: 3px; background: #4ae3b0; }
    .from {
      font-family: "Cascadia Mono", Consolas, ui-monospace, monospace;
      font-size: 11px; letter-spacing: .12em; color: #6b7885; margin: 0 0 10px;
    }
    .to {
      font-family: "Cascadia Mono", Consolas, ui-monospace, monospace;
      font-size: 13px; letter-spacing: .06em; color: #4ae3b0;
      margin: 0 0 16px; word-break: break-all;
    }
    .note { font-size: 14px; line-height: 1.7; margin: 0 0 20px; }
    a { color: #4ae3b0; }
  </style>
</head>
<body>
  <div class="box">
    <div class="mark" aria-hidden="true"></div>
    <p class="from">{from}</p>
    <p class="to">{dest}</p>
    <p class="note">{note}</p>
    <p><a href={dest}>若未自動跳轉，請點此前往 →</a></p>
  </div>
  <script is:inline define:vars={{ dest, preserveQuery }}>
    // 保留來源頁的查詢字串，讓 /search.html?q=xxx → /projects.html?q=xxx 仍可運作
    var target = preserveQuery ? dest + window.location.search : dest;
    window.location.replace(target);
  </script>
</body>
</html>
