---
import { u } from '../lib/url';
// src/pages/index.astro —— 首頁
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SignalPanel from '../components/SignalPanel.astro';
import ProjectRow from '../components/ProjectRow.astro';
import TerminalBlock from '../components/TerminalBlock.astro';
import '../styles/tokens.css';
import '../styles/global.css';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Sid Automation Lab',
  description:
    'Sid 的個人自動化學習實驗室，記錄以圖像辨識與模擬輸入為核心的自動化工具開發與學習過程。專案涵蓋 OCR 觸發點擊、跨遊戲壓槍腳本、流亡黯道 2 工具箱等。',
  url: 'https://sid-1996.github.io/sid-automation-lab/',
};
---

<BaseLayout
  title="Sid Automation Lab — 個人自動化學習實驗室｜圖像辨識與模擬輸入"
  description="Sid 的個人自動化學習實驗室，記錄以圖像辨識與模擬輸入為核心的自動化工具開發與學習過程。專案涵蓋 OCR 觸發點擊、跨遊戲壓槍腳本、流亡黯道 2 工具箱等。"
  path="index.html"
  navKey="home"
  og="/images/og-home.png"
  jsonLd={jsonLd}
>
  <SiteHeader slot="header" navKey="home" />

  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="shell hero__inner">
      <div class="hero__copy">
        <p class="hero__eyebrow mono">personal automation lab</p>
        <h1 class="hero__title">個人自動化<br />學習實驗室</h1>
        <div class="hero__rule" aria-hidden="true"></div>
        <p class="hero__lede">
          一邊學習、一邊打造以<strong>圖像辨識</strong>與<strong>模擬輸入</strong>為核心的半自動減負工具。
          六個公開專案，每個都寫明它能幫忙做什麼、用的技術，以及該到哪裡取得。
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={u('/projects.html')}>
            <span class="btn__prompt" aria-hidden="true">$</span>ls ./projects
          </a>
          <a class="btn btn--ghost" href="#principle">開發理念</a>
        </div>
        <dl class="hero__readout">
          <div><dt class="mono">公開專案</dt><dd class="mono">06</dd></div>
          <div><dt class="mono">技術領域</dt><dd class="mono">AHK / PY / C#</dd></div>
          <div><dt class="mono">授權模式</dt><dd class="mono">OSS + 商業</dd></div>
        </dl>
      </div>

      <div class="hero__panel">
        <SignalPanel />
      </div>
    </div>
  </section>

  <!-- ===== 精選專案 ===== -->
  <section class="section section--tight">
    <div class="shell">
      <header class="section__head">
        <p class="section__eyebrow">featured modules</p>
        <h2 class="section__title">精選專案</h2>
        <p class="section__lede">
          三個最能代表本站技術取向的專案。全部六個專案與版本、授權、下載入口都在專案頁。
        </p>
      </header>

      <div class="featured">
        {featured.map((p, i) => <ProjectRow project={p} index={i} />)}
      </div>

      <p class="featured__more">
        <a class="btn btn--ghost" href={u('/projects.html')}>
          <span class="btn__prompt" aria-hidden="true">$</span>ls ./projects --all
        </a>
      </p>
    </div>
  </section>

  <!-- ===== 技術棧 ===== -->
  <section class="section section--panel">
    <div class="shell">
      <header class="section__head">
        <p class="section__eyebrow">tech stack</p>
        <h2 class="section__title">技術棧</h2>
        <p class="section__lede">以下是公開專案實際使用的技術，不是未來功能藍圖。</p>
      </header>

      <div class="stack">
        <article class="stack__item">
          <h3 class="mono">AutoHotkey v2</h3>
          <p>系統層按鍵／滑鼠／像素偵測，遊戲輔助腳本主力。</p>
          <span class="tag mono">AHK</span>
        </article>
        <article class="stack__item">
          <h3 class="mono">Python 3.13</h3>
          <p>進階影像處理與 GUI（uv 管理）。</p>
          <span class="tag mono">PY</span>
        </article>
        <article class="stack__item">
          <h3 class="mono">PySide6 / PyQt6</h3>
          <p>工具箱與 OCR 觸發工具的桌面 GUI 框架。</p>
          <span class="tag mono">GUI</span>
        </article>
        <article class="stack__item">
          <h3 class="mono">RapidOCR + ONNX</h3>
          <p>OCR 辨識引擎（繁中預設模型，另有英文專用模型）。</p>
          <span class="tag mono">OCR</span>
        </article>
        <article class="stack__item">
          <h3 class="mono">OpenCV</h3>
          <p>形狀比對／圖像模板比對（matchTemplate + NMS）。</p>
          <span class="tag mono">CV</span>
        </article>
        <article class="stack__item">
          <h3 class="mono">pynput / Frida</h3>
          <p>前景 SendInput 與後台注入輸入（另有混合模式）。</p>
          <span class="tag mono">IO</span>
        </article>
        <article class="stack__item">
          <h3 class="mono">C# / WPF</h3>
          <p>壓槍腳本 SidAllFPS 的桌面介面（.NET 10 x64）。</p>
          <span class="tag mono">C#</span>
        </article>
        <article class="stack__item">
          <h3 class="mono">視窗比例座標</h3>
          <p>跨解析度設計（0~1 比值）。</p>
          <span class="tag mono">COORD</span>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== 開發理念（C 的局部元素） ===== -->
  <section class="section" id="principle">
    <div class="shell principle__inner">
      <div class="principle__copy">
        <p class="section__eyebrow">principle</p>
        <h2 class="section__title">開發理念</h2>
        <p class="principle__lead">
          讓工具回歸<strong>省時省力</strong>；不讀寫記憶體、不修改遊戲檔案，只做圖像辨識與模擬輸入。
        </p>
        <p class="lede">
          這條原則適用於全部工具：工具的定位是半自動減負，不取代玩家的操作判斷。
          開源專案公開原始碼，授權條款以各獨立倉庫為準；壓槍腳本為商業授權，提供 14 天試用。
        </p>
      </div>

      <TerminalBlock title="principle.md">
        <p class="term-line"><span class="term-line__prompt" aria-hidden="true">&gt;</span><span class="term-line__cmd">cat principle.md</span></p>
        <p class="term-line term-line--ok"><span class="term-line__prompt" aria-hidden="true">&gt;</span><span class="term-line__cmd">不讀寫記憶體</span><span class="term-line__note">— 全部工具</span></p>
        <p class="term-line term-line--ok"><span class="term-line__prompt" aria-hidden="true">&gt;</span><span class="term-line__cmd">不修改遊戲檔案</span><span class="term-line__note">— 全部工具</span></p>
        <p class="term-line"><span class="term-line__prompt" aria-hidden="true">&gt;</span><span class="term-line__cmd">圖像辨識 + 模擬輸入</span><span class="term-line__note">— 唯一手段</span></p>
        <p class="term-line"><span class="term-line__prompt" aria-hidden="true">&gt;</span><span class="term-line__cmd">半自動減負</span><span class="term-line__note">— 不取代玩家判斷</span></p>
      </TerminalBlock>
    </div>
  </section>

  <!-- ===== 贊助支持 ===== -->
  <section class="section section--sunk" id="support">
    <div class="shell">
      <div class="sup">
        <div class="sup__copy">
          <p class="section__eyebrow">support the project</p>
          <h2 class="section__title">贊助支持</h2>
          <p class="sup__lede">
            如果這些 Automation / OCR 研究專案對你有幫助，歡迎支持後續開發與維護。
          </p>
          <p class="lede">
            六個公開專案中，五個為公開授權、免費取用。贊助不是使用條件，而是你覺得這些工具值得被繼續維護下去。
          </p>
          <div class="sup__actions">
            <a class="btn btn--primary" href={u('/sponsor.html')}>
              <span class="btn__prompt" aria-hidden="true">$</span>open sponsor
            </a>
            <a class="btn btn--ghost" href={u('/license.html')}>
              <span class="btn__prompt" aria-hidden="true">$</span>購買授權（NT$ 500）
            </a>
          </div>
        </div>

        <div class="sup__panel">
          <TerminalBlock title="sponsor.md">
            <p class="term-line"><span class="term-line__prompt" aria-hidden="true">&gt;</span><span class="term-line__cmd">cat sponsor.md</span></p>
            <p class="term-line term-line--ok"><span class="term-line__prompt" aria-hidden="true">&gt;</span><span class="term-line__cmd">ECPay / PayPal / AFDIAN</span><span class="term-line__note">— 四個管道</span></p>
            <p class="term-line term-line--ok"><span class="term-line__prompt" aria-hidden="true">&gt;</span><span class="term-line__cmd">公開授權專案</span><span class="term-line__note">— 5 個，免費</span></p>
            <p class="term-line term-line--warn"><span class="term-line__prompt" aria-hidden="true">&gt;</span><span class="term-line__cmd">正式版授權另計</span><span class="term-line__note">— 500 元</span></p>
          </TerminalBlock>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 聯絡作者 ===== -->
  <section class="section" id="contact">
    <div class="shell">
      <header class="section__head">
        <p class="section__eyebrow">contact</p>
        <h2 class="section__title">聯絡作者</h2>
        <p class="section__lede">
          工具使用問題、合作提案、贊助支持或任何建議，都可以從這裡找到作者。
        </p>
      </header>

      <div class="ct">
        <a class="ct__card" href="https://www.facebook.com/talksometingshit/" target="_blank" rel="noopener noreferrer">
          <span class="ct__kind mono">facebook</span>
          <span class="ct__name">Facebook 粉絲專頁：Sid</span>
          <span class="ct__desc">留言或私訊，最快的聯絡方式。授權啟用也走這個管道。</span>
        </a>
        <a class="ct__card" href="https://www.dailymotion.com/user/SoloSid" target="_blank" rel="noopener noreferrer">
          <span class="ct__kind mono">youtube</span>
          <span class="ct__name">YouTube 頻道：SoloSid</span>
          <span class="ct__desc">操作示範與工具更新紀錄。</span>
        </a>
        <a class="ct__card" href="https://docs.google.com/forms/d/e/1FAIpQLSdk7p6XQXcX0z5ls7DMlEIzy0aj43MrnUOYviH9Taum4J68Bg/viewform" target="_blank" rel="noopener noreferrer">
          <span class="ct__kind mono">form</span>
          <span class="ct__name">Google 表單</span>
          <span class="ct__desc">結構化的問題回報表單，適合回報異常與細節。</span>
        </a>
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  /* ---------- HERO ---------- */
  .hero { position: relative; overflow: hidden; border-bottom: var(--bw) solid var(--line); }
  .hero__grid {
    position: absolute; inset: 0; pointer-events: none;
    background-image:
      linear-gradient(var(--line-soft) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
    background-size: 56px 56px;
    opacity: .55;
  }
  .hero__inner {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
    gap: var(--sp-8); align-items: center;
    padding-block: var(--sp-9);
  }
  .hero__eyebrow {
    font-size: var(--fs-3xs); letter-spacing: var(--tracking-mono);
    text-transform: uppercase; color: var(--signal); margin: 0 0 var(--sp-4);
  }
  .hero__title {
    margin: 0; font-size: clamp(var(--fs-4xl), 5.4vw, var(--fs-5xl));
    line-height: var(--lh-tight); letter-spacing: var(--tracking-tight); font-weight: 800;
  }
  .hero__rule { width: 96px; height: 3px; background: var(--signal); margin: var(--sp-5) 0; }
  .hero__lede { color: var(--ink-2); font-size: var(--fs-md); max-width: 52ch; margin: 0 0 var(--sp-6); }
  .hero__lede strong { color: var(--ink); font-weight: 600; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
  .hero__readout {
    display: flex; flex-wrap: wrap; gap: var(--sp-6);
    margin: var(--sp-7) 0 0; padding-top: var(--sp-5);
    border-top: var(--bw) solid var(--line);
  }
  .hero__readout div { margin: 0; }
  .hero__readout dt { font-size: var(--fs-3xs); letter-spacing: var(--tracking-mono); color: var(--ink-3); margin-bottom: var(--sp-1); }
  .hero__readout dd { margin: 0; font-size: var(--fs-lg); color: var(--ink); font-weight: 600; }

  /* ---------- 精選 ---------- */
  .featured { border-top: var(--bw) solid var(--line); }
  .featured__more { margin: var(--sp-6) 0 0; }

  /* ---------- 技術棧 ---------- */
  .stack {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--bw); background: var(--line);
    border: var(--bw) solid var(--line);
  }
  .stack__item { background: var(--panel); padding: var(--sp-5) var(--sp-4); }
  .stack__item h3 {
    margin: 0 0 var(--sp-2); font-size: var(--fs-sm);
    color: var(--signal); letter-spacing: var(--tracking-wide);
  }
  .stack__item p { margin: 0 0 var(--sp-3); color: var(--ink-2); font-size: var(--fs-sm); }

  /* ---------- 理念 ---------- */
  .principle__inner {
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
    gap: var(--sp-8); align-items: center;
  }
  .principle__lead {
    font-size: clamp(var(--fs-lg), 2.6vw, var(--fs-2xl));
    line-height: var(--lh-snug); letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--sp-4); max-width: 26ch; font-weight: 600;
  }
  .principle__lead strong { color: var(--signal); font-weight: 700; }

  /* ---------- 贊助 ---------- */
  .sup {
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
    gap: var(--sp-8); align-items: center;
  }
  .sup__lede {
    font-size: clamp(var(--fs-lg), 2.4vw, var(--fs-xl));
    line-height: var(--lh-snug); letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--sp-4); max-width: 30ch; font-weight: 600;
  }
  .sup__actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-6); }

  /* ---------- 聯絡 ---------- */
  .ct {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--bw); background: var(--line); border: var(--bw) solid var(--line);
  }
  .ct__card {
    background: var(--panel); padding: var(--sp-5);
    display: flex; flex-direction: column; gap: var(--sp-2);
    text-decoration: none; transition: background var(--dur-fast) var(--ease);
  }
  .ct__card:hover { background: var(--panel-2); }
  .ct__kind {
    font-size: var(--fs-3xs); letter-spacing: var(--tracking-mono);
    text-transform: uppercase; color: var(--signal-dim);
  }
  .ct__name { font-size: var(--fs-md); color: var(--ink); font-weight: 600; }
  .ct__card:hover .ct__name { color: var(--signal); }
  .ct__desc { font-size: var(--fs-sm); color: var(--ink-2); }

  @media (max-width: 1023px) {
    .hero__inner { grid-template-columns: 1fr; gap: var(--sp-7); padding-block: var(--sp-8); }
    .stack { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .principle__inner { grid-template-columns: 1fr; gap: var(--sp-6); }
    .sup { grid-template-columns: 1fr; gap: var(--sp-6); }
    .ct { grid-template-columns: 1fr; }
  }
  @media (max-width: 767px) {
    .hero__inner { padding-block: var(--sp-7); }
    .hero__readout { gap: var(--sp-5); }
    .stack { grid-template-columns: 1fr; }
  }
</style>
